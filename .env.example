# DASHSCOPE_API_KEY: Required for Alibaba Cloud DashScope (Qwen) API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
DASHSCOPE_API_KEY="YOUR_DASHSCOPE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TENCENT_SECRET_ID and TENCENT_SECRET_KEY: Required for Tencent Cloud TTS API calls.
TENCENT_SECRET_ID="YOUR_TENCENT_SECRET_ID"
TENCENT_SECRET_KEY="YOUR_TENCENT_SECRET_KEY"

# VOLC_APP_ID and VOLC_ACCESS_TOKEN: Required for Volcengine (火山引擎) TTS API calls.
VOLC_APP_ID="YOUR_VOLC_APP_ID"
VOLC_ACCESS_TOKEN="YOUR_VOLC_ACCESS_TOKEN"
